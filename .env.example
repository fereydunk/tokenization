# tokenization (CSFLT) — environment configuration
#
# Copy to `.env` (gitignored); the wizard / scripts populate empty fields as you
# walk the setup steps. Mirrors demo-csfle-cspe-cloud, with the AWS-KMS pieces
# replaced by local token-vault pieces.

# ── Confluent Cloud (filled by scripts/00_discover_env.sh) ───────────────────
ENV_ID=
ENV_NAME=
CLUSTER_ID=
CLUSTER_NAME=
BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

SR_ID=
SR_URL=
SR_API_KEY=
SR_API_SECRET=

# ── Local token vault (stands in for Protegrity / HashiCorp Vault) ───────────
# Started by the wizard (Card 1) or `python3 mock-vault/server.py`.
VAULT_URL=http://localhost:9099
VAULT_PORT=9099
VAULT_DB_PATH=/tmp/csflt-mock-vault/vault.db

# Token spaces — one namespace per protected tag (filled by 01_setup_vault.sh).
PII_TOKEN_SPACE=pii-ssn
PCI_TOKEN_SPACE=pci-cc

# Vault API keys (minted by 01_setup_vault.sh). Capability-based, across all
# spaces — the CSFLT analog of per-principal KEK RBAC in the CSFLE demo:
#   AUTHORIZED   = can_tokenize + can_detokenize  (producer + authorized consumer)
#   UNAUTHORIZED = can_tokenize only              (consumer that only ever sees tokens)
VAULT_ADMIN_KEY=
VAULT_AUTHORIZED_KEY=
VAULT_UNAUTHORIZED_KEY=

# ── Schema / topic ───────────────────────────────────────────────────────────
# The TOKENIZE rule authorization on Confluent Cloud requires Stream Governance
# ADVANCED on the environment (same entitlement CSFLE/CSPE use). No client-side
# license JWT is needed on Cloud.
TOPIC=mortgage-tokenized

# Plaintext baseline topic — same schema body but NO ruleSet, so data is stored
# UN-tokenized. Used by the wizard's "produce without tokenization" path to show
# the contrast (anyone reading this topic sees the real values).
PLAINTEXT_TOPIC=mortgage-plaintext

# ── Tokenization rule parameters (baked into the schema's ruleSet) ───────────
# Kept here for reference / wizard display; 02_register_schemas.sh reads them.
TOKENIZE_VAULT_TYPE=mock-vault
